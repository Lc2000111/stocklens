# Copy to .env (in this folder or the folder above it) and fill in the real value.
# Never commit the real .env.

# Required for the AI features (gpt-6-luna via Portkey)
PORTKEY_API_KEY=

# Optional AI usage limits (off unless set to a positive number)
# AI_CALLS_PER_HOUR=10
# AI_DAILY_CALL_CAP=300
# AI_DAILY_TOKEN_CAP=2000000
# Optional: minutes between screener rescans (default 10)
# REFRESH_COOLDOWN_MIN=10
